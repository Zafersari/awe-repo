{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": ["js/**/*.ts", "js/**/*.js", "src/**/*.ts", "src/**/*.tsx"]
}
